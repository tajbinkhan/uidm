{
    "manifest_version": 3,
    "name": "UIDM",
    "version": "0.3.0",
    "description": "Send browser downloads to the UIDM download manager.",
    "key": "",
    "background": {
        "service_worker": "background.js",
        "scripts": [ "rules.js", "post.js", "media.js", "background.js" ]
    },
    "browser_specific_settings": {
        "gecko": { "id": "uidm@uidm.local", "strict_min_version": "128.0" }
    },
    "permissions": [ "nativeMessaging", "downloads", "cookies", "contextMenus", "storage", "webRequest", "proxy", "scripting" ],
    "host_permissions": [ "<all_urls>" ],
    "content_scripts": [
        { "matches": [ "<all_urls>" ], "js": [ "content.js" ], "all_frames": true, "run_at": "document_idle" }
    ],
    "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
    "action": {
        "default_title": "UIDM",
        "default_popup": "popup.html",
        "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
    }
}
